# =============================================================================
# PDF Forge - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values
# =============================================================================

# ===================
# 🔐 SECURITY (IMPORTANT!)
# ===================
# API Key for authentication - CHANGE THIS IN PRODUCTION!
# Leave empty for no authentication (not recommended for production)
API_KEY=your-super-secret-api-key-change-me

# ===================
# ⚡ PERFORMANCE
# ===================
# Number of concurrent PDF conversion workers
# Tune with representative document load tests
MAX_WORKERS=4
# Compose mounts 256 MiB /dev/shm. Enable only with adequate shared memory.
CHROME_USE_DEV_SHM=true

# Maximum request body size in bytes
# Default: 33554432 (32 MiB)
MAX_BODY_SIZE=33554432
# Bound requests and retained inputs, including background jobs
MAX_INFLIGHT_REQUESTS=16
MAX_INFLIGHT_BYTES=134217728
PROCESSING_WORKERS=2
# End-to-end synchronous request deadline in seconds
REQUEST_TIMEOUT=120

# ===================
# 🚦 RATE LIMITING
# ===================
# Maximum requests per minute per IP address
# Set to 0 to disable rate limiting
RATE_LIMIT=100

# ===================
# 🌐 CORS (Cross-Origin Resource Sharing)
# ===================
# Comma-separated list of allowed origins
# Use * to allow all origins (not recommended for production)
# Example: https://myapp.com,https://admin.myapp.com
CORS_ORIGINS=*

# ===================
# ⏱️ TIMEOUTS
# ===================
# HTTP read timeout in seconds
READ_TIMEOUT=300

# HTTP write timeout in seconds
WRITE_TIMEOUT=300

# ===================
# 📝 LOGGING
# ===================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ===================
# 🖥️ SERVER
# ===================
# Port to expose (for docker-compose)
PORT=8080

# ===================
# 📊 RESOURCES (Docker)
# ===================
# CPU limit (number of cores)
CPU_LIMIT=2

# Memory limit
MEMORY_LIMIT=2G
